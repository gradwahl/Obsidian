TEXT(TXT_BACK_HINT, "Back / Cancel", "Wstecz / Anuluj", "Volver / Cancelar")
TEXT(TXT_REFRESH_HINT, "Refresh Pegasus-DL [R]", "Odśwież katalog Pegasus-DL [R]", "Actualizar Pegasus-DL [R]")
