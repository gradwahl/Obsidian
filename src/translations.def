TEXT(TXT_DESCRIPTION_FALLBACK, "Package from %s (version %s).", "Pakiet z katalogu %s (wersja %s).", "Paquete de %s (versión %s).", "Paquet de %s (version %s).", "Pakket uit %s (versie %s).", "Paket aus %s (Version %s).", "Pacchetto da %s (versione %s).", "来自 %s 的安装包（版本 %s）。", "Пакет из %s (версия %s).")
TEXT(TXT_DESC_SPIDER_MAN_2, "exFAT image optimized for ShadowMountPlus. Native PS5 support (FW 13.60) with fast mounting without copying FFPKG.", "Obraz exFAT zoptymalizowany pod ShadowMountPlus. Natywna obsługa PS5 (FW 13.60), błyskawiczne montowanie bez kopiowania FFPKG.", "Imagen exFAT optimizada para ShadowMountPlus. Compatible con PS5 (FW 13.60), con montaje rápido sin copiar FFPKG.", "Image exFAT optimisée pour ShadowMountPlus. Compatible PS5 (FW 13.60), avec montage rapide sans copie FFPKG.", "exFAT-image geoptimaliseerd voor ShadowMountPlus. Ondersteunt PS5 (FW 13.60) met snel koppelen zonder FFPKG te kopiëren.", "Für ShadowMountPlus optimiertes exFAT-Abbild. PS5-Unterstützung (FW 13.60) mit schnellem Einbinden ohne FFPKG-Kopie.", "Immagine exFAT ottimizzata per ShadowMountPlus. Supporto PS5 (FW 13.60) con montaggio rapido senza copiare FFPKG.", "为 ShadowMountPlus 优化的 exFAT 镜像。支持 PS5（固件 13.60），无需复制 FFPKG 即可快速挂载。", "Образ exFAT для ShadowMountPlus. Поддержка PS5 (FW 13.60) с быстрым подключением без копирования FFPKG.")
TEXT(TXT_DESC_GOD_OF_WAR, "Complete .exfat package ready to mount in /data/homebrew/ using ShadowMountPlus on PS5 13.60.", "Pełny pakiet .exfat gotowy do natychmiastowego podpięcia w /data/homebrew/ przez demona ShadowMountPlus na PS5 13.60.", "Paquete .exfat completo listo para montar en /data/homebrew/ con ShadowMountPlus en PS5 13.60.", "Paquet .exfat complet prêt à monter dans /data/homebrew/ avec ShadowMountPlus sur PS5 13.60.", "Compleet .exfat-pakket klaar om te koppelen in /data/homebrew/ met ShadowMountPlus op PS5 13.60.", "Vollständiges .exfat-Paket zum Einbinden unter /data/homebrew/ mit ShadowMountPlus auf PS5 13.60.", "Pacchetto .exfat completo da montare in /data/homebrew/ con ShadowMountPlus su PS5 13.60.", "完整的 .exfat 安装包，可在 PS5 13.60 上通过 ShadowMountPlus 挂载到 /data/homebrew/。", "Полный пакет .exfat для подключения в /data/homebrew/ через ShadowMountPlus на PS5 13.60.")
TEXT(TXT_DESC_DEMONS_SOULS, "PS5 release in .ffpkg format. Includes 4K/60FPS assets and a compatibility patch for Kernel 13.60.", "Wydanie PS5 w formacie .ffpkg. Zawiera komplet zasobów 4K/60FPS oraz łatkę kompatybilności pod Kernel 13.60.", "Edición PS5 en formato .ffpkg. Incluye recursos 4K/60FPS y un parche de compatibilidad para Kernel 13.60.", "Version PS5 au format .ffpkg. Inclut les ressources 4K/60FPS et un correctif de compatibilité Kernel 13.60.", "PS5-uitgave in .ffpkg-formaat. Bevat 4K/60FPS-bestanden en een compatibiliteitspatch voor Kernel 13.60.", "PS5-Ausgabe im .ffpkg-Format. Enthält 4K/60FPS-Ressourcen und einen Kompatibilitätspatch für Kernel 13.60.", "Edizione PS5 in formato .ffpkg. Include risorse 4K/60FPS e una patch di compatibilità per Kernel 13.60.", ".ffpkg 格式的 PS5 版本。包含 4K/60FPS 资源和 Kernel 13.60 兼容补丁。", "Версия PS5 в формате .ffpkg. Включает ресурсы 4K/60FPS и патч совместимости с Kernel 13.60.")
TEXT(TXT_DESC_STELLAR_BLADE, ".exfat image ready for ShadowMountPlus with extracted executable modules and full DualSense haptics support.", "Obraz .exfat (ShadowMountPlus Ready) z wyodrębnionymi modułami wykonywalnymi i pełnym wsparciem haptyki DualSense.", "Imagen .exfat lista para ShadowMountPlus con módulos ejecutables extraídos y soporte háptico DualSense.", "Image .exfat pour ShadowMountPlus avec modules exécutables extraits et prise en charge haptique DualSense.", ".exfat-image voor ShadowMountPlus met uitgepakte uitvoerbare modules en DualSense-haptiek.", ".exfat-Abbild für ShadowMountPlus mit extrahierten ausführbaren Modulen und DualSense-Haptik.", "Immagine .exfat per ShadowMountPlus con moduli eseguibili estratti e supporto aptico DualSense.", "适用于 ShadowMountPlus 的 .exfat 镜像，包含已提取的可执行模块并支持 DualSense 触觉反馈。", "Образ .exfat для ShadowMountPlus с извлечёнными исполняемыми модулями и тактильной отдачей DualSense.")
TEXT(TXT_DESC_RATCHET_AND_CLANK, ".ffpkg package optimized for direct access from internal NVMe storage (/data/homebrew) or /mnt/ext0.", "Paczka .ffpkg zoptymalizowana pod bezpośredni odczyt z wewnętrznego dysku NVMe (/data/homebrew) lub /mnt/ext0.", "Paquete .ffpkg optimizado para acceso directo desde NVMe interno (/data/homebrew) o /mnt/ext0.", "Paquet .ffpkg optimisé pour un accès direct depuis le NVMe interne (/data/homebrew) ou /mnt/ext0.", ".ffpkg-pakket geoptimaliseerd voor directe toegang vanaf interne NVMe-opslag (/data/homebrew) of /mnt/ext0.", ".ffpkg-Paket für direkten Zugriff vom internen NVMe-Speicher (/data/homebrew) oder /mnt/ext0.", "Pacchetto .ffpkg ottimizzato per l'accesso diretto da NVMe interno (/data/homebrew) o /mnt/ext0.", ".ffpkg 安装包，针对内部 NVMe 存储（/data/homebrew）或 /mnt/ext0 的直接读取进行了优化。", "Пакет .ffpkg для прямого доступа с внутреннего NVMe (/data/homebrew) или /mnt/ext0.")
TEXT(TXT_DESC_ASTRO_BOT, "Native .exfat image for PS5 13.60. Write directly to external storage at /mnt/ext0/homebrew.", "Natywny obraz .exfat dla PS5 13.60. Błyskawiczny zapis bezpośrednio na partycję zewnętrzną /mnt/ext0/homebrew.", "Imagen .exfat nativa para PS5 13.60. Escritura directa al almacenamiento externo en /mnt/ext0/homebrew.", "Image .exfat native pour PS5 13.60. Écriture directe sur le stockage externe /mnt/ext0/homebrew.", "Native .exfat-image voor PS5 13.60. Rechtstreeks schrijven naar externe opslag in /mnt/ext0/homebrew.", "Natives .exfat-Abbild für PS5 13.60. Direktes Schreiben auf externen Speicher unter /mnt/ext0/homebrew.", "Immagine .exfat nativa per PS5 13.60. Scrittura diretta su memoria esterna in /mnt/ext0/homebrew.", "适用于 PS5 13.60 的原生 .exfat 镜像。直接写入 /mnt/ext0/homebrew 外部存储。", "Образ .exfat для PS5 13.60. Прямая запись на внешний накопитель /mnt/ext0/homebrew.")
TEXT(TXT_DESC_BLOODBORNE, "PS4 FPKG (.pkg) with an integrated 60 FPS patch and unlocked 1080p/1440p resolution for PS5.", "Pakiet PS4 FPKG (.pkg) ze zintegrowaną łatką 60 FPS oraz odblokowaną rozdzielczością 1080p/1440p dla PS5.", "PS4 FPKG (.pkg) con parche de 60 FPS integrado y resolución 1080p/1440p desbloqueada para PS5.", "PS4 FPKG (.pkg) avec correctif 60 FPS intégré et résolution 1080p/1440p débloquée pour PS5.", "PS4 FPKG (.pkg) met geïntegreerde 60 FPS-patch en ontgrendelde 1080p/1440p-resolutie voor PS5.", "PS4 FPKG (.pkg) mit integriertem 60-FPS-Patch und freigeschalteter 1080p/1440p-Auflösung für PS5.", "PS4 FPKG (.pkg) con patch 60 FPS integrata e risoluzione 1080p/1440p sbloccata per PS5.", "PS4 FPKG（.pkg），集成 60 FPS 补丁并为 PS5 解锁 1080p/1440p 分辨率。", "PS4 FPKG (.pkg) со встроенным патчем 60 FPS и разблокированным разрешением 1080p/1440p для PS5.")
TEXT(TXT_DESC_RED_DEAD_REDEMPTION, "Complete .pkg installer (PS4 FPKG) with unlocked frame rate on PlayStation 5.", "Kompletny instalator .pkg (PS4 FPKG) z odblokowanym frameratem na konsoli PlayStation 5.", "Instalador .pkg completo (PS4 FPKG) con tasa de fotogramas desbloqueada en PlayStation 5.", "Installateur .pkg complet (PS4 FPKG) avec fréquence d'images débloquée sur PlayStation 5.", "Volledig .pkg-installatiepakket (PS4 FPKG) met ontgrendelde framesnelheid op PlayStation 5.", "Vollständiges .pkg-Installationspaket (PS4 FPKG) mit freigeschalteter Bildrate auf PlayStation 5.", "Programma di installazione .pkg completo (PS4 FPKG) con frequenza dei fotogrammi sbloccata su PlayStation 5.", "完整的 .pkg 安装程序（PS4 FPKG），在 PlayStation 5 上解锁帧率。", "Полный установщик .pkg (PS4 FPKG) с разблокированной частотой кадров на PlayStation 5.")
TEXT(TXT_DESC_GHOST_OF_TSUSHIMA, ".pkg version ready for direct installation using Package Installer or a Wolodrive download.", "Wersja .pkg gotowa do bezpośredniej instalacji przez Package Installer lub strumieniowego pobrania Wolodrive.", "Versión .pkg lista para instalar con Package Installer o mediante descarga de Wolodrive.", "Version .pkg prête à installer avec Package Installer ou par téléchargement Wolodrive.", ".pkg-versie klaar voor installatie met Package Installer of een Wolodrive-download.", ".pkg-Version zur Installation mit Package Installer oder über einen Wolodrive-Download.", "Versione .pkg da installare con Package Installer o tramite download Wolodrive.", ".pkg 版本，可通过 Package Installer 或 Wolodrive 下载后直接安装。", "Версия .pkg для установки через Package Installer или загрузку Wolodrive.")
TEXT(TXT_DESC_DRIVECLUB, "Classic PS4 FPKG (.pkg) edition including all season passes and an unlocked frame rate.", "Klasyczna edycja PS4 FPKG (.pkg) zawierająca wszystkie przepustki sezonowe oraz odblokowany klatkaż.", "Edición clásica PS4 FPKG (.pkg) con todos los pases de temporada y tasa de fotogramas desbloqueada.", "Édition classique PS4 FPKG (.pkg) avec tous les passes de saison et fréquence d'images débloquée.", "Klassieke PS4 FPKG-editie (.pkg) met alle seizoenspassen en ontgrendelde framesnelheid.", "Klassische PS4-FPKG-Ausgabe (.pkg) mit allen Saisonpässen und freigeschalteter Bildrate.", "Edizione classica PS4 FPKG (.pkg) con tutti i pass stagionali e frequenza dei fotogrammi sbloccata.", "经典 PS4 FPKG（.pkg）版本，包含全部季票并解锁帧率。", "Классическое издание PS4 FPKG (.pkg) со всеми сезонными абонементами и разблокированной частотой кадров.")
TEXT(TXT_ACTION_UNAVAILABLE, "Package downloads and installation are not available in this build yet.", "Pobieranie i instalowanie pakietów nie jest jeszcze dostępne w tej wersji.", "La descarga e instalación de paquetes aún no están disponibles en esta versión.", "Le téléchargement et l’installation de paquets ne sont pas encore disponibles dans cette version.", "Pakketten downloaden en installeren is nog niet beschikbaar in deze versie.", "Das Herunterladen und Installieren von Paketen ist in dieser Version noch nicht verfügbar.", "Il download e l’installazione dei pacchetti non sono ancora disponibili in questa versione.", "此版本尚不支持安装包的下载和安装。", "Скачивание и установка пакетов в этой версии пока недоступны.")
TEXT(TXT_WINDOW_TITLE, "Wolodrive — PS5 Homebrew Store & Pegasus-DL", "Wolodrive — Sklep homebrew PS5 i Pegasus-DL", "Wolodrive — Tienda homebrew PS5 y Pegasus-DL", "Wolodrive — Boutique homebrew PS5 et Pegasus-DL", "Wolodrive — PS5-homebrewwinkel en Pegasus-DL", "Wolodrive — PS5-Homebrew-Shop und Pegasus-DL", "Wolodrive — Negozio homebrew PS5 e Pegasus-DL", "Wolodrive — PS5 自制软件商店与 Pegasus-DL", "Wolodrive — Магазин homebrew PS5 и Pegasus-DL")
TEXT(TXT_FORMAT_FOLDER, ".ffpkg (Folder package)", ".ffpkg (Pakiet folderowy)", ".ffpkg (Paquete de carpeta)", ".ffpkg (Paquet dossier)", ".ffpkg (Mappakket)", ".ffpkg (Ordnerpaket)", ".ffpkg (Pacchetto cartella)", ".ffpkg（文件夹安装包）", ".ffpkg (Пакет папки)")
TEXT(TXT_TRANSLATING, "Translating catalog description…", "Tłumaczenie opisu z katalogu…", "Traduciendo la descripción del catálogo…", "Traduction de la description du catalogue…", "Catalogusbeschrijving vertalen…", "Katalogbeschreibung wird übersetzt…", "Traduzione della descrizione del catalogo…", "正在翻译目录描述…", "Перевод описания из каталога…")
TEXT(TXT_TRANSLATION_UNCONFIGURED, "Configure a translation service to translate catalog descriptions.", "Skonfiguruj usługę tłumaczeń, aby tłumaczyć opisy z katalogu.", "Configura un servicio de traducción para traducir las descripciones del catálogo.", "Configurez un service de traduction pour traduire les descriptions du catalogue.", "Stel een vertaaldienst in om catalogusbeschrijvingen te vertalen.", "Richten Sie einen Übersetzungsdienst für Katalogbeschreibungen ein.", "Configura un servizio di traduzione per tradurre le descrizioni del catalogo.", "请配置翻译服务以翻译目录描述。", "Настройте сервис перевода описаний из каталога.")
TEXT(TXT_TRANSLATION_FAILED, "Translation unavailable. You can view the original description.", "Tłumaczenie niedostępne. Możesz wyświetlić oryginalny opis.", "Traducción no disponible. Puedes ver la descripción original.", "Traduction indisponible. Vous pouvez consulter la description originale.", "Vertaling niet beschikbaar. Je kunt de oorspronkelijke beschrijving bekijken.", "Übersetzung nicht verfügbar. Sie können die Originalbeschreibung anzeigen.", "Traduzione non disponibile. Puoi visualizzare la descrizione originale.", "翻译暂不可用。您可以查看原始描述。", "Перевод недоступен. Можно посмотреть исходное описание.")
