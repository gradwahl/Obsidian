TEXT(TXT_SCREEN_VIEWER_HINT, "Left/Right: screenshots    Escape / Circle: close", "Lewo/prawo: zrzuty    Escape / Circle: zamknij", "Izquierda/derecha: capturas    Escape / Circle: cerrar", "Gauche/droite : captures    Échap / Circle : fermer", "Links/rechts: schermafbeeldingen    Escape / Circle: sluiten", "Links/rechts: Screenshots    Escape / Circle: schließen", "Sinistra/destra: schermate    Escape / Circle: chiudi", "左右：切换截图    Escape / Circle：关闭", "Влево/вправо: скриншоты    Escape / Circle: закрыть")
