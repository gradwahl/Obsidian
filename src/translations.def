TEXT(TXT_READY_PLAY, "READY TO PLAY  •  %.1f GB", "GOTOWE DO GRY  •  %.1f GB", "LISTO PARA JUGAR  •  %.1f GB")
TEXT(TXT_READY, "Pegasus-DL ready", "Pegasus-DL Ready", "Pegasus-DL listo")
TEXT(TXT_STARTED, "Started %s (%s)", "Uruchomiono %s (%s)", "Iniciado %s (%s)")
TEXT(TXT_DOWNLOAD_STARTED, "Download started: %s [%s]", "Rozpoczęto pobieranie: %s [%s]", "Descarga iniciada: %s [%s]")
TEXT(TXT_DOWNLOAD_ACTIVE, "Downloading: %s (%.1f%%)", "Pobieranie w toku: %s (%.1f%%)", "Descargando: %s (%.1f%%)")
TEXT(TXT_MOUNTED, "ShadowMountPlus: Mounted %s (%s)", "ShadowMountPlus: Zamontowano %s (%s)", "ShadowMountPlus: Montado %s (%s)")
TEXT(TXT_PACKAGE_READY, "FPKG package %s is ready to launch", "Pakiet FPKG %s jest gotowy do uruchomienia", "El paquete FPKG %s está listo para iniciar")
TEXT(TXT_CANCELLED, "Download cancelled: %s", "Wstrzymano i anulowano pobieranie: %s", "Descarga cancelada: %s")
TEXT(TXT_RETURNED, "Returned to the start of the catalog", "Powrót na początek siatki katalogu", "Vuelta al inicio del catálogo")
TEXT(TXT_COMPLETE, "Download complete: %s [%s]", "Ukończono pobieranie: %s [%s]", "Descarga completada: %s [%s]")
TEXT(TXT_SYNC_MANIFEST, "Pegasus-DL: Downloading default-sources.json...", "Pegasus-DL: Pobieranie default-sources.json...", "Pegasus-DL: Descargando default-sources.json...")
TEXT(TXT_SYNC_SUBCATALOG, "Pegasus-DL: Loading catalog (%d/%d)...", "Pegasus-DL: Wczytywanie sub-katalogu (%d/%d)...", "Pegasus-DL: Cargando catálogo (%d/%d)...")
TEXT(TXT_SYNC_COVER, "Caching cover: %s (%d/%d)...", "Cache okładek: %s (%d/%d)...", "Guardando portada: %s (%d/%d)...")
TEXT(TXT_SYNC_DONE, "Pegasus-DL: %d games (%d sources)  •  Covers: %d/%d", "Pegasus-DL: %d gier (%d sub-źródeł)  •  Okładki: %d/%d", "Pegasus-DL: %d juegos (%d fuentes)  •  Portadas: %d/%d")
TEXT(TXT_SYNC_LOADED, "Pegasus-DL: Loaded %d remote packages", "Pegasus-DL: Załadowano %d pakietów z katalogu zdalnego", "Pegasus-DL: %d paquetes remotos cargados")
TEXT(TXT_SYNC_CACHED, "Pegasus-DL: Synced manifest (%d sources) and covers (%d)", "Pegasus-DL: Zsynchronizowano manifest (%d źródeł) i cache okładek (%d)", "Pegasus-DL: Manifiesto (%d fuentes) y portadas (%d) sincronizados")
TEXT(TXT_SYNC_BUSY, "Pegasus-DL sync is already running...", "Synchronizacja katalogu Pegasus-DL już trwa w tle...", "La sincronización de Pegasus-DL ya está en curso...")
TEXT(TXT_LANGUAGE, "Language [L / □]: %s", "Język [L / □]: %s", "Idioma [L / □]: %s")
TEXT(TXT_LANGUAGE_CHANGED, "Language: %s", "Język: %s", "Idioma: %s")
TEXT(TXT_LANGUAGE_UNSAVED, "Language: %s (preference could not be saved)", "Język: %s (nie zapisano ustawienia)", "Idioma: %s (no se pudo guardar la preferencia)")
TEXT(TXT_DESCRIPTION_FALLBACK, "Package from %s (version %s). Ready to download and install on PS5 (13.60).", "Pakiet z katalogu %s (Wersja %s). Gotowy do bezpośredniego pobrania i instalacji na PS5 (13.60).", "Paquete de %s (versión %s). Listo para descargar e instalar en PS5 (13.60).")
TEXT(TXT_DESC_SPIDER_MAN_2, "exFAT image optimized for ShadowMountPlus. Native PS5 support (FW 13.60) with fast mounting without copying FFPKG.", "Obraz exFAT zoptymalizowany pod ShadowMountPlus. Natywna obsługa PS5 (FW 13.60), błyskawiczne montowanie bez kopiowania FFPKG.", "Imagen exFAT optimizada para ShadowMountPlus. Compatible con PS5 (FW 13.60), con montaje rápido sin copiar FFPKG.")
TEXT(TXT_DESC_GOD_OF_WAR, "Complete .exfat package ready to mount in /data/homebrew/ using ShadowMountPlus on PS5 13.60.", "Pełny pakiet .exfat gotowy do natychmiastowego podpięcia w /data/homebrew/ przez demona ShadowMountPlus na PS5 13.60.", "Paquete .exfat completo listo para montar en /data/homebrew/ con ShadowMountPlus en PS5 13.60.")
TEXT(TXT_DESC_DEMONS_SOULS, "PS5 release in .ffpkg format. Includes 4K/60FPS assets and a compatibility patch for Kernel 13.60.", "Wydanie PS5 w formacie .ffpkg. Zawiera komplet zasobów 4K/60FPS oraz łatkę kompatybilności pod Kernel 13.60.", "Edición PS5 en formato .ffpkg. Incluye recursos 4K/60FPS y un parche de compatibilidad para Kernel 13.60.")
TEXT(TXT_DESC_STELLAR_BLADE, ".exfat image ready for ShadowMountPlus with extracted executable modules and full DualSense haptics support.", "Obraz .exfat (ShadowMountPlus Ready) z wyodrębnionymi modułami wykonywalnymi i pełnym wsparciem haptyki DualSense.", "Imagen .exfat lista para ShadowMountPlus con módulos ejecutables extraídos y soporte háptico DualSense.")
TEXT(TXT_DESC_RATCHET_AND_CLANK, ".ffpkg package optimized for direct access from internal NVMe storage (/data/homebrew) or /mnt/ext0.", "Paczka .ffpkg zoptymalizowana pod bezpośredni odczyt z wewnętrznego dysku NVMe (/data/homebrew) lub /mnt/ext0.", "Paquete .ffpkg optimizado para acceso directo desde NVMe interno (/data/homebrew) o /mnt/ext0.")
TEXT(TXT_DESC_ASTRO_BOT, "Native .exfat image for PS5 13.60. Write directly to external storage at /mnt/ext0/homebrew.", "Natywny obraz .exfat dla PS5 13.60. Błyskawiczny zapis bezpośrednio na partycję zewnętrzną /mnt/ext0/homebrew.", "Imagen .exfat nativa para PS5 13.60. Escritura directa al almacenamiento externo en /mnt/ext0/homebrew.")
TEXT(TXT_DESC_BLOODBORNE, "PS4 FPKG (.pkg) with an integrated 60 FPS patch and unlocked 1080p/1440p resolution for PS5.", "Pakiet PS4 FPKG (.pkg) ze zintegrowaną łatką 60 FPS oraz odblokowaną rozdzielczością 1080p/1440p dla PS5.", "PS4 FPKG (.pkg) con parche de 60 FPS integrado y resolución 1080p/1440p desbloqueada para PS5.")
TEXT(TXT_DESC_RED_DEAD_REDEMPTION, "Complete .pkg installer (PS4 FPKG) with unlocked frame rate on PlayStation 5.", "Kompletny instalator .pkg (PS4 FPKG) z odblokowanym frameratem na konsoli PlayStation 5.", "Instalador .pkg completo (PS4 FPKG) con tasa de fotogramas desbloqueada en PlayStation 5.")
TEXT(TXT_DESC_GHOST_OF_TSUSHIMA, ".pkg version ready for direct installation using Package Installer or a Wolodrive download.", "Wersja .pkg gotowa do bezpośredniej instalacji przez Package Installer lub strumieniowego pobrania Wolodrive.", "Versión .pkg lista para instalar con Package Installer o mediante descarga de Wolodrive.")
TEXT(TXT_DESC_DRIVECLUB, "Classic PS4 FPKG (.pkg) edition including all season passes and an unlocked frame rate.", "Klasyczna edycja PS4 FPKG (.pkg) zawierająca wszystkie przepustki sezonowe oraz odblokowany klatkaż.", "Edición clásica PS4 FPKG (.pkg) con todos los pases de temporada y tasa de fotogramas desbloqueada.")
